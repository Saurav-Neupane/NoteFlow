# ---------------------------------------------------------------
# NoteFlow — Environment variables (optional)
#
# The Firebase web config is public by design and is baked into
# src/services/firebase.ts, so the app runs WITHOUT this file.
# Override any value below only if you point NoteFlow at a
# different Firebase project.
#   Firebase Console → Project settings → General → Your apps
# ---------------------------------------------------------------

VITE_FIREBASE_API_KEY=AIzaSyBEKu4GsvBz6PRMA0xCY9aTwa1N6DsiIjk
VITE_FIREBASE_AUTH_DOMAIN=noteflow-637ca.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=noteflow-637ca
VITE_FIREBASE_STORAGE_BUCKET=noteflow-637ca.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=539135541946
VITE_FIREBASE_APP_ID=1:539135541946:web:180e777197eebd62c97883

# ---------------------------------------------------------------
# Cloudinary — attachment uploads (unsigned preset, no secret)
#   Cloudinary Console → Settings → Upload → Upload presets
# ---------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=iij3g2g5
VITE_CLOUDINARY_UPLOAD_PRESET=noteflow_preset
